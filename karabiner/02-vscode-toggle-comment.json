{
    "title": "VSCode: Right Option + / to toggle comment",
    "rules": [
        {
            "description": "VSCode: Right Option + / to toggle comment (like Ctrl + /)",
            "manipulators": [
                {
                    "conditions": [
                        {
                            "bundle_identifiers": ["^com\\.microsoft\\.VSCode$"],
                            "type": "frontmost_application_if"
                        }
                    ],
                    "from": {
                        "key_code": "slash",
                        "modifiers": { "mandatory": ["right_option"] }
                    },
                    "to": [
                        {
                            "key_code": "slash",
                            "modifiers": ["left_command"]
                        }
                    ],
                    "type": "basic"
                }
            ]
        }
    ]
}
